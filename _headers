# ============================================================
# Svit Academy — HTTP-заголовки (Cloudflare Pages)
# ============================================================

# Статика (картинки, шрифти, іконки) — довгий кеш
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS, JS і дані — завжди перевіряти свіжість (щоб правки з'являлися одразу)
/assets/css/*
  Cache-Control: public, no-cache

/assets/js/*
  Cache-Control: public, no-cache

/assets/data/*
  Cache-Control: public, no-cache

# Базова безпека для всіх сторінок
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
